{
  "name": "leetcode-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript LeetCode practice workspace (see ../ROADMAP.md)",
  "scripts": {
    "new": "node scripts/new.mjs",
    "solve": "node scripts/solve.mjs",
    "dash": "node scripts/dashboard.mjs",
    "sync": "node scripts/sync-data.mjs",
    "plan": "node scripts/plan.mjs",
    "next": "node scripts/today.mjs",
    "today": "node scripts/today.mjs",
    "day": "node scripts/day.mjs",
    "learn": "node scripts/learn.mjs",
    "done": "node scripts/done.mjs",
    "task": "node scripts/task.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}